# Absolute path to a legally obtained, user-supplied game image.
# Keep the real value in .env.local, which is ignored by Git.
ROM_PATH=/absolute/path/to/Pokemon Alpha Sapphire.3ds

# Stable ByteMatch version/category identifier for this target.
VERSION=AS_EUR_REV2

# Private extraction/build root outside the checkout.
DECOMP_PRIVATE=/absolute/path/outside/repository/AS_EUR_REV2

